# ArioClip Environment Configuration
# Copy this file to .env and fill in your API keys

# ==============================================
# Local Stack (No Docker)
# ==============================================

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://supoclip:supoclip_password@localhost:5432/supoclip

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Temp directories
TEMP_DIR=./data/uploads
OUTPUT_DIR=./data/outputs

# ==============================================
# Transcription (local whisperx)
# ==============================================

# Model: tiny, base, small, medium, large
WHISPERX_MODEL=tiny
WHISPERX_ROOT_DIR=~/.cache/whisperx

# ==============================================
# LLM Provider (for transcript analysis)
# ==============================================

# Format: "provider:model-name"
# Examples:
#   - openai:gpt-4o-mini (requires OPENAI_API_KEY)
#   - google-gla:gemini-2.0-flash (requires GOOGLE_API_KEY)
#   - anthropic:claude-3-haiku (requires ANTHROPIC_API_KEY)
#   - openai:gemma-3-4b-it (local llama.cpp with OPENAI_BASE_URL)
LLM=openai:gemma-3-4b-it

# For local llama.cpp / OpenAI-compatible servers
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=not-needed

# Hosted API keys (optional if using local LLM)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# ==============================================
# YouTube Upload (OAuth)
# ==============================================

# Google Cloud OAuth 2.0 credentials for YouTube upload
# Create at: https://console.cloud.google.com/apis/credentials
# Required scopes: https://www.googleapis.com/auth/youtube.upload
# Application type: Desktop app
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ==============================================
# YouTube Download
# ==============================================

YOUTUBE_DOWNLOAD_PROVIDER=yt_dlp
YOUTUBE_METADATA_PROVIDER=yt_dlp
APIFY_YOUTUBE_DEFAULT_QUALITY=1080
APIFY_API_TOKEN=

# ==============================================
# AI Model Configuration
# ==============================================

WHISPER_MODEL_SIZE=base
DEFAULT_PROCESSING_MODE=fast
FAST_MODE_MAX_CLIPS=4
FAST_MODE_TRANSCRIPT_MODEL=base

# ==============================================
# Authentication
# ==============================================

BETTER_AUTH_SECRET=change_me_in_production
SELF_HOST=true
BACKEND_AUTH_SECRET=change_me_backend_auth_secret
ALLOW_UNSIGNED_BACKEND_AUTH=true
APP_SETTINGS_ENCRYPTION_KEY=change_me_settings_encryption_secret
CORS_ORIGINS=http://localhost:3000,http://localhost:3107
DISABLE_SIGN_UP=false
NEXT_PUBLIC_LANDING_ONLY_MODE=false

# ==============================================
# Frontend
# ==============================================

NEXT_PUBLIC_APP_URL=http://localhost:3107
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SELF_HOST=true

# ==============================================
# Optional: Pexels for B-Roll
# ==============================================

PEXELS_API_KEY=

# ==============================================
# Optional: Resend for emails
# ==============================================

RESEND_API_KEY=
RESEND_FROM_EMAIL="ArioClip <onboarding@resend.dev>"

# ==============================================
# Optional: Analytics
# ==============================================

NEXT_PUBLIC_DATAFAST_WEBSITE_ID=
NEXT_PUBLIC_DATAFAST_DOMAIN=
NEXT_PUBLIC_DATAFAST_ALLOW_LOCALHOST=false

# ==============================================
# Optional: Stripe / Monetization (SELF_HOST=false only)
# ==============================================

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
NEXT_PUBLIC_PRO_PRICE_MONTHLY=10
NEXT_PUBLIC_SCALE_PRICE_MONTHLY=50
FREE_PLAN_TASK_LIMIT=10
PRO_PLAN_TASK_LIMIT=50
SCALE_PLAN_TASK_LIMIT=300

# ==============================================
# Optional: Feedback (Discord webhooks)
# ==============================================

DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_SALES_WEBHOOK_URL=
